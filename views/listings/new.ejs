<% layout('/layouts/boilerplate') -%>

<style>
    /* ===== PAGE WRAPPER ===== */
    .new-listing-wrapper {
        min-height: calc(100vh - 80px);
        background: linear-gradient(135deg, #fafafa 0%, #f4effa 50%, #fdedf2 100%);
        padding: 40px 24px 60px;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        box-sizing: border-box;
        width: 100%;
    }

    .form-container {
        width: 100%;
        max-width: 660px;
        animation: fadeIn 0.4s ease forwards;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ===== BACK BUTTON ===== */
    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #717171;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 22px;
        padding: 6px 12px;
        border-radius: 8px;
        background: #ffffff;
        border: 1px solid #ebebeb;
        width: fit-content;
        transition: all 0.2s ease;
    }

    .back-btn:hover {
        color: #FF385C;
        border-color: #FF385C;
        background: #fff5f7;
        transform: translateX(-3px);
    }

    /* ===== HEADER ===== */
    .form-header {
        margin-bottom: 28px;
    }

    .form-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(26px, 4vw, 34px);
        font-weight: 800;
        color: #1a1a2e;
        margin-bottom: 8px;
        position: relative;
        display: inline-block;
    }

    .form-header h1::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 48px;
        height: 4px;
        background: linear-gradient(to right, #FF385C, #D70466);
        border-radius: 2px;
    }

    .form-header p {
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        color: #717171;
        margin-top: 10px;
        line-height: 1.6;
    }

    /* ===== FORM CARD ===== */
    .form-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 38px 34px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05), 0 1px 4px rgba(0, 0, 0, 0.03);
        box-sizing: border-box;
    }

    /* ===== FORM GROUPS ===== */
    .form-group {
        margin-bottom: 24px;
    }

    .form-group label {
        display: block;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 8px;
    }

    .label-optional {
        font-weight: 400;
        font-size: 12px;
        color: #888888;
        margin-left: 4px;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 13px 16px;
        font-size: 14px;
        font-family: 'Poppins', sans-serif;
        border: 2px solid #eeeeee;
        border-radius: 12px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        color: #1a1a2e;
        background: #fafafa;
        box-sizing: border-box;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        border-color: #FF385C;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(255, 56, 92, 0.08);
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
        color: #b0b0b0;
        font-weight: 300;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 110px;
        line-height: 1.6;
    }

    .helper-text {
        font-size: 12px;
        color: #888888;
        margin-top: 6px;
        padding-left: 2px;
    }

    /* ===== BOOTSTRAP CLIENT VALIDATION OVERRIDES ===== */
    /* When form is submitted and has .was-validated */
    .was-validated .form-group input:invalid,
    .was-validated .form-group textarea:invalid {
        border-color: #dc3545 !important;
        background-color: #fff9f9 !important;
        box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.12) !important;
    }

    .was-validated .form-group input:valid,
    .was-validated .form-group textarea:valid {
        border-color: #198754 !important;
        background-color: #f9fffb !important;
        box-shadow: 0 0 0 3px rgba(25, 135, 84, 0.12) !important;
    }

    /* Validation feedback message styling */
    .was-validated input:invalid ~ .invalid-feedback,
    .was-validated textarea:invalid ~ .invalid-feedback {
        display: block !important;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        color: #dc3545;
        margin-top: 6px;
        padding-left: 2px;
    }

    .was-validated input:valid ~ .valid-feedback,
    .was-validated textarea:valid ~ .valid-feedback {
        display: block !important;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        color: #198754;
        margin-top: 6px;
        padding-left: 2px;
    }

    /* ===== TWO-COLUMN ROW ===== */
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    /* ===== PRICE INPUT WITH PREFIX ===== */
    .input-prefix {
        position: relative;
    }

    .input-prefix .prefix-symbol {
        position: absolute;
        left: 14px;
        top: 24px;
        transform: translateY(-50%);
        font-family: 'DM Sans', sans-serif;
        font-size: 15px;
        font-weight: 700;
        color: #717171;
        pointer-events: none;
    }

    .input-prefix input {
        padding-left: 30px !important;
    }

    /* ===== SECTION DIVIDER ===== */
    .section-divider {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 28px 0 24px;
    }

    .section-divider::before,
    .section-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #eeeeee;
    }

    .section-divider span {
        font-family: 'DM Sans', sans-serif;
        font-size: 11px;
        font-weight: 700;
        color: #a0a0a0;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    /* ===== IMAGE PREVIEW BOX ===== */
    .image-preview {
        margin-top: 10px;
        width: 100%;
        height: 150px;
        border-radius: 12px;
        border: 2px dashed #e0e0e0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #a0a0a0;
        background: #fafafa;
        overflow: hidden;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .image-preview i {
        font-size: 26px;
    }

    .image-preview span {
        font-family: 'DM Sans', sans-serif;
        font-size: 12px;
        font-weight: 500;
    }

    .image-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
    }

    .image-preview.has-image {
        border: none;
    }

    .image-preview.has-image i,
    .image-preview.has-image span {
        display: none;
    }

    .image-preview.has-image img {
        display: block;
    }

    /* ===== SUBMIT BUTTON ===== */
    .submit-btn {
        width: 100%;
        padding: 15px;
        background: linear-gradient(135deg, #FF385C, #D70466);
        color: #ffffff;
        border: none;
        border-radius: 12px;
        font-family: 'DM Sans', sans-serif;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 4px 18px rgba(255, 56, 92, 0.28);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 8px;
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 22px rgba(255, 56, 92, 0.38);
    }

    .submit-btn:active {
        transform: translateY(0);
    }

    .submit-btn i {
        font-size: 14px;
        transition: transform 0.2s;
    }

    .submit-btn:hover i {
        transform: translateX(4px);
    }

    /* ===== RESPONSIVE MEDIA QUERIES ===== */
    @media (max-width: 600px) {
        .new-listing-wrapper {
            padding: 24px 16px 40px;
        }

        .form-card {
            padding: 26px 20px;
            border-radius: 16px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .image-preview {
            height: 130px;
        }
    }
</style>

<div class="new-listing-wrapper">
    <div class="form-container">

        <!-- Back Button -->
        <a href="/listings" class="back-btn">
            <i class="fa-solid fa-arrow-left"></i> All Listings
        </a>

        <!-- Header -->
        <div class="form-header">
            <h1>Create a New Listing</h1>
            <p>Share your space with travelers from around the world. Fill in the details below to publish your place.</p>
        </div>

        <!-- Form Card -->
        <div class="form-card">
            <form action="/listings" method="POST" novalidate class="needs-validation">

                <!-- Title -->
                <div class="form-group">
                    <label for="title">Title</label>
                    <input type="text" id="title" name="listing[title]" placeholder="e.g. Cozy Beachfront Cottage" required>
                    <div class="invalid-feedback">
                        Please add a little Title.
                    </div>
                    <div class="valid-feedback">
                        Title looks good!
                    </div>
                    <p class="helper-text">Catchy and descriptive names attract more guests.</p>
                </div>

                <!-- Description -->
                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="listing[description]" placeholder="Tell guests what makes your place special, the amenities available, and what the neighbourhood is like..." required></textarea>
                    <div class="invalid-feedback">
                        Please add a little Description.
                    </div>
                    <div class="valid-feedback">
                        Description looks good!
                    </div>
                </div>

                <!-- Image URL (Optional) -->
                <div class="form-group">
                    <label for="image">
                        Image URL <span class="label-optional">(optional)</span>
                    </label>
                    <input type="text" id="image" name="listing[image]" placeholder="https://example.com/your-image.jpg" oninput="previewImage(this.value)">
                    <!-- Live Image Preview -->
                       <div class="valid-feedback">
                        Image URL is optional!.
                    </div>
                    <div class="image-preview" id="imagePreview">
                        <i class="fa-regular fa-image"></i>
                        <span>Image preview will appear here</span>
                        <img src="" alt="Preview" id="previewImg">
                    </div>

                </div>

                <div class="section-divider">
                    <span>Pricing & Location</span>
                </div>

                <!-- Price + Country Row -->
                <div class="form-row">
                    <div class="form-group">
                        <label for="price">Price per Night</label>
                        <div class="input-prefix">
                            <span class="prefix-symbol">₹</span>
                            <input type="number" id="price" name="listing[price]" placeholder="1,500" min="0" required>
                            <div class="invalid-feedback">
                                Please add a Price.
                            </div>
                              <div class="valid-feedback">
                                Price looks good!
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="country">Country</label>
                        <input type="text" id="country" name="listing[country]" placeholder="e.g. India" required>
                        <div class="invalid-feedback">
                            Please add a Country.
                        </div>
                        <div class="valid-feedback">
                            Country looks good!
                        </div>
                    </div>
                </div>

                <!-- Location -->
                <div class="form-group">
                    <label for="location">Location</label>
                    <input type="text" id="location" name="listing[location]" placeholder="e.g. Malibu, California or Mumbai" required>
                    <div class="invalid-feedback">
                        Please add a Location.
                    </div>
                    <div class="valid-feedback">
                        Location looks good!
                    </div>
                    <p class="helper-text">City, district, or area to help travelers find your listing.</p>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="submit-btn">
                    Create Listing
                    <i class="fa-solid fa-arrow-right"></i>
                </button>

            </form>
        </div>
    </div>
</div>

<!-- Scripts -->
<script>
    // 1. Live Image Preview Script
    function previewImage(url) {
        const container = document.getElementById('imagePreview');
        const img = document.getElementById('previewImg');
        if (url && url.trim() !== '') {
            img.src = url.trim();
            img.onload = () => container.classList.add('has-image');
            img.onerror = () => container.classList.remove('has-image');
        } else {
            container.classList.remove('has-image');
            img.src = '';
        }
    }
  
</script>