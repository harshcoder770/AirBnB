<% layout('/layouts/boilerplate') -%>

<style>
    /* Put the padding on this container instead of body */
    .listings-wrapper {
        padding: 36px 80px 60px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 36px;
    }

    .page-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: 36px;
        font-weight: 800;
        color: #1a1a2e;
        position: relative;
    }

    .page-header h1::after {
        content: '';
        position: absolute;
        bottom: -6px;
        left: 0;
        width: 50px;
        height: 4px;
        background: linear-gradient(to right, #FF385C, #FF5A5F);
        border-radius: 2px;
    }

    .create-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        background: linear-gradient(135deg, #FF385C, #D70466);
        color: #fff;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        border-radius: 50px;
        box-shadow: 0 4px 16px rgba(255, 56, 92, 0.35);
        transition: all 0.3s ease;
    }

    .create-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(255, 56, 92, 0.45);
    }

    .listings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
        gap: 28px;
    }

    .card {
        display: block;
        text-decoration: none;
        color: inherit;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.06);
        transition: all 0.35s ease;
    }

    .card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.12);
    }

    .card-img {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 3.4;
        overflow: hidden;
    }

    .card-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .card:hover .card-img img {
        transform: scale(1.06);
    }

    .wishlist-btn {
        position: absolute;
        top: 14px;
        right: 14px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(4px);
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 2;
        transition: all 0.2s ease;
        font-size: 16px;
        color: #333;
    }

    .wishlist-btn:hover {
        background: #fff;
        color: #FF385C;
        transform: scale(1.1);
    }

    .card-tag {
        position: absolute;
        bottom: 14px;
        left: 14px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(4px);
        padding: 4px 12px;
        border-radius: 20px;
        font-family: 'DM Sans', sans-serif;
        font-size: 11px;
        font-weight: 700;
        color: #1a1a2e;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        z-index: 2;
    }

    .card-info {
        padding: 16px 18px 20px;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
    }

    .card-title {
        font-family: 'DM Sans', sans-serif;
        font-size: 16px;
        font-weight: 700;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 72%;
        color: #1a1a2e;
    }

    .card-rating {
        display: flex;
        align-items: center;
        gap: 4px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: #1a1a2e;
    }

    .card-rating i {
        color: #FFB400;
        font-size: 12px;
    }

    .card-location {
        font-family: 'Poppins', sans-serif;
        font-size: 13px;
        color: #888;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .card-location i {
        font-size: 11px;
        color: #FF385C;
    }

    .card-divider {
        width: 100%;
        height: 1px;
        background: #f0f0f0;
        margin: 12px 0;
    }

    .card-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-price {
        font-family: 'DM Sans', sans-serif;
        font-size: 17px;
        color: #1a1a2e;
    }

    .card-price b {
        font-weight: 700;
    }

    .card-price span {
        font-size: 13px;
        color: #888;
    }

    .card-view {
        font-family: 'DM Sans', sans-serif;
        font-size: 12px;
        font-weight: 600;
        color: #FF385C;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    @media (max-width: 1024px) {
        .listings-wrapper {
            padding: 32px 40px;
        }
    }

    @media (max-width: 768px) {
        .listings-wrapper {
            padding: 24px 20px;
        }
        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }
    }
</style>

<div class="listings-wrapper">
    <!-- Header -->
    <div class="page-header">
        <h1>All Listings</h1>
        <a href="/listings/new" class="create-btn">
            <i class="fa-solid fa-plus"></i>
            Create New Listing
        </a>
    </div>

    <!-- Listings Grid -->
    <div class="listings-grid">
        <% for(let listing of listings) { %>
            <a href="/listings/<%= listing._id %>" class="card">
                <div class="card-img">
                    <img src="<%= listing.image %>" alt="<%= listing.title %>" loading="lazy">
                    <button class="wishlist-btn" onclick="event.preventDefault(); this.querySelector('i').classList.toggle('fa-solid'); this.querySelector('i').classList.toggle('fa-regular');">
                        <i class="fa-regular fa-heart"></i>
                    </button>
                    <div class="card-tag"><%= listing.country %></div>
                </div>
                <div class="card-info">
                    <div class="card-header">
                        <div class="card-title"><%= listing.title %></div>
                        <div class="card-rating">
                            <i class="fa-solid fa-star"></i>
                            4.5
                        </div>
                    </div>
                    <div class="card-location">
                        <i class="fa-solid fa-location-dot"></i>
                        <%= listing.location %>, <%= listing.country %>
                    </div>
                    <div class="card-divider"></div>
                    <div class="card-bottom">
                        <div class="card-price">
                            <b>&#8377;<%= listing.price.toLocaleString('en-IN') %></b>
                            <span> / night</span>
                        </div>
                        <div class="card-view">
                            View <i class="fa-solid fa-arrow-right"></i>
                        </div>
                    </div>
                </div>
            </a>
        <% } %>
    </div>
</div>