<% layout('/layouts/boilerplate') -%>

<style>
    /* ===== PAGE WRAPPER ===== */
    .edit-listing-wrapper {
        min-height: calc(100vh - 80px);
        background: linear-gradient(135deg, #fafafa 0%, #f4effa 50%, #fdedf2 100%);
        padding: 40px 24px 60px;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        box-sizing: border-box;
        width: 100%;
    }

    .form-container {
        width: 100%;
        max-width: 660px;
        animation: fadeIn 0.4s ease forwards;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ===== BACK BUTTON ===== */
    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #717171;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 22px;
        padding: 6px 12px;
        border-radius: 8px;
        background: #ffffff;
        border: 1px solid #ebebeb;
        width: fit-content;
        transition: all 0.2s ease;
    }

    .back-btn:hover {
        color: #FF385C;
        border-color: #FF385C;
        background: #fff5f7;
        transform: translateX(-3px);
    }

    /* ===== HEADER ===== */
    .form-header {
        margin-bottom: 28px;
    }

    .form-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(26px, 4vw, 34px);
        font-weight: 800;
        color: #1a1a2e;
        margin-bottom: 8px;
        position: relative;
        display: inline-block;
    }

    .form-header h1::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 48px;
        height: 4px;
        background: linear-gradient(to right, #FF385C, #D70466);
        border-radius: 2px;
    }

    .form-header p {
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        color: #717171;
        margin-top: 10px;
        line-height: 1.6;
    }

    /* ===== FORM CARD ===== */
    .form-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 38px 34px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05), 0 1px 4px rgba(0, 0, 0, 0.03);
        box-sizing: border-box;
    }

    /* ===== FORM GROUPS ===== */
    .form-group {
        margin-bottom: 24px;
    }

    .form-group label {
        display: block;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 8px;
    }

    .label-optional {
        font-weight: 400;
        font-size: 12px;
        color: #888888;
        margin-left: 4px;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 13px 16px;
        font-size: 14px;
        font-family: 'Poppins', sans-serif;
        border: 2px solid #eeeeee;
        border-radius: 12px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        color: #1a1a2e;
        background: #fafafa;
        box-sizing: border-box;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        border-color: #FF385C;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(255, 56, 92, 0.08);
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
        color: #b0b0b0;
        font-weight: 300;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 110px;
        line-height: 1.6;
    }

    .helper-text {
        font-size: 12px;
        color: #888888;
        margin-top: 6px;
        padding-left: 2px;
    }

    /* ===== BOOTSTRAP CLIENT VALIDATION OVERRIDES ===== */
    .was-validated .form-group input:invalid,
    .was-validated .form-group textarea:invalid {
        border-color: #dc3545 !important;
        background-color: #fff9f9 !important;
        box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.12) !important;
    }

    .was-validated .form-group input:valid,
    .was-validated .form-group textarea:valid {
        border-color: #198754 !important;
        background-color: #f9fffb !important;
        box-shadow: 0 0 0 3px rgba(25, 135, 84, 0.12) !important;
    }

    .was-validated input:invalid ~ .invalid-feedback,
    .was-validated textarea:invalid ~ .invalid-feedback {
        display: block !important;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        color: #dc3545;
        margin-top: 6px;
        padding-left: 2px;
    }

    .was-validated input:valid ~ .valid-feedback,
    .was-validated textarea:valid ~ .valid-feedback {
        display: block !important;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        color: #198754;
        margin-top: 6px;
        padding-left: 2px;
    }

    /* ===== TWO-COLUMN ROW ===== */
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    /* ===== PRICE INPUT WITH PREFIX ===== */
    .input-prefix {
        position: relative;
    }

    .input-prefix .prefix-symbol {
        position: absolute;
        left: 14px;
        top: 24px;
        transform: translateY(-50%);
        font-family: 'DM Sans', sans-serif;
        font-size: 15px;
        font-weight: 700;
        color: #717171;
        pointer-events: none;
    }

    .input-prefix input {
        padding-left: 30px !important;
    }

    /* ===== SECTION DIVIDER ===== */
    .section-divider {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 28px 0 24px;
    }

    .section-divider::before,
    .section-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #eeeeee;
    }

    .section-divider span {
        font-family: 'DM Sans', sans-serif;
        font-size: 11px;
        font-weight: 700;
        color: #a0a0a0;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    /* ===== IMAGE PREVIEW BOX ===== */
    .image-preview {
        margin-top: 10px;
        width: 100%;
        height: 160px;
        border-radius: 12px;
        border: 2px dashed #e0e0e0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #a0a0a0;
        background: #fafafa;
        overflow: hidden;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .image-preview i {
        font-size: 26px;
    }

    .image-preview span {
        font-family: 'DM Sans', sans-serif;
        font-size: 12px;
        font-weight: 500;
    }

    .image-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
    }

    .image-preview.has-image {
        border: none;
    }

    .image-preview.has-image i,
    .image-preview.has-image span {
        display: none;
    }

    .image-preview.has-image img {
        display: block;
    }

    /* ===== ACTION BUTTONS (UPDATE & CANCEL) ===== */
    .form-actions {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 12px;
        margin-top: 12px;
    }

    .submit-btn {
        width: 100%;
        padding: 15px;
        background: linear-gradient(135deg, #FF385C, #D70466);
        color: #ffffff;
        border: none;
        border-radius: 12px;
        font-family: 'DM Sans', sans-serif;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 4px 18px rgba(255, 56, 92, 0.28);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 22px rgba(255, 56, 92, 0.38);
    }

    .submit-btn:active {
        transform: translateY(0);
    }

    .cancel-btn {
        width: 100%;
        padding: 15px;
        background: #f1f5f9;
        color: #475569;
        border: none;
        border-radius: 12px;
        font-family: 'DM Sans', sans-serif;
        font-size: 15px;
        font-weight: 700;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
    }

    .cancel-btn:hover {
        background: #e2e8f0;
    }

    /* ===== RESPONSIVE MEDIA QUERIES ===== */
    @media (max-width: 600px) {
        .edit-listing-wrapper {
            padding: 24px 16px 40px;
        }

        .form-card {
            padding: 26px 20px;
            border-radius: 16px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-actions {
            grid-template-columns: 1fr;
        }

        .image-preview {
            height: 140px;
        }
    }
</style>

<div class="edit-listing-wrapper">
    <div class="form-container">

        <!-- Back Button -->
        <a href="/listings/<%= listing._id %>" class="back-btn">
            <i class="fa-solid fa-arrow-left"></i> Back to Listing
        </a>

        <!-- Header -->
        <div class="form-header">
            <h1>Edit your Listing</h1>
            <p>Update property information, photos, pricing, or location details for this listing.</p>
        </div>

        <!-- Form Card -->
        <div class="form-card">
            <!-- Overriding POST method to PUT with client-side validation -->
            <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

                <!-- Title -->
                <div class="form-group">
                    <label for="title">Title</label>
                    <input type="text" id="title" name="listing[title]" value="<%= listing.title %>" required>
                    <div class="invalid-feedback">
                        Please enter a valid title.
                    </div>
                    <div class="valid-feedback">
                        Title looks good!
                    </div>
                    <p class="helper-text">Give your place a descriptive and catchy name.</p>
                </div>

                <!-- Description -->
                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="listing[description]" required><%= listing.description %></textarea>
                    <div class="invalid-feedback">
                        Please enter a description.
                    </div>
                    <div class="valid-feedback">
                        Description looks good!
                    </div>
                </div>

                <!-- Image URL -->
                <div class="form-group">
                    <label for="image">
                        Image Upload
                    </label>
                    <!-- Original Image Preview -->
<div class="mb-3">
    <label class="form-label fw-bold small text-muted">Original Listing Image</label>
    <div class="rounded-3 overflow-hidden border p-1" style="max-width: 250px;">
        <img src="<%= (listing.image && listing.image.url) ? listing.image.url : listing.image %>" 
             alt="Listing Image" 
             style="width: 100%; height: 140px; object-fit: cover; border-radius: 8px;">
    </div>
</div>
                    <input type="file" id="image" name="listing[image]">
                    <div class="valid-feedback">
                        Image Uploaded Successfully!.
                    </div>
                    <div class="invalid-feedback">
                        Please Upload a Image!.
                    </div>
                   
                </div>

                <div class="section-divider">
                    <span>Pricing & Location</span>
                </div>

                <!-- Price + Country Row -->
                <div class="form-row">
                    <div class="form-group">
                        <label for="price">Price per Night</label>
                        <div class="input-prefix">
                            <span class="prefix-symbol">₹</span>
                            <input type="number" id="price" name="listing[price]" value="<%= listing.price %>" min="0" required>
                            <div class="invalid-feedback">
                                Please enter a valid price.
                            </div>
                            <div class="valid-feedback">
                                Price looks good!
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="country">Country</label>
                        <input type="text" id="country" name="listing[country]" value="<%= listing.country %>" required>
                        <div class="invalid-feedback">
                            Please enter a country.
                        </div>
                        <div class="valid-feedback">
                            Country looks good!
                        </div>
                    </div>
                </div>

                <!-- Location -->
                <div class="form-group">
                    <label for="location">Location</label>
                    <input type="text" id="location" name="listing[location]" value="<%= listing.location %>" required>
                    <div class="invalid-feedback">
                        Please enter a location.
                    </div>
                    <div class="valid-feedback">
                        Location looks good!
                    </div>  
                    <p class="helper-text">City, district, or area to help travelers find your place.</p>
                </div>

                <!-- Form Action Buttons -->
                <div class="form-actions">
                    <button type="submit" class="submit-btn">
                        Save Changes
                        <i class="fa-solid fa-check"></i>
                    </button>
                    <a href="/listings/<%= listing._id %>" class="cancel-btn">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>

