<% layout('/layouts/boilerplate') -%>

<!-- Mapbox GL JS & CSS -->
<link href="https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.js"></script>

<%
    /* Calculate live average rating from actual database reviews */
    const allReviews = (listing.reviews && listing.reviews.length > 0) ? listing.reviews : [];
    let avgRating = 0;
    if (allReviews.length > 0) {
        let total = allReviews.reduce((acc, curr) => acc + (Number(curr.rating) || 0), 0);
        avgRating = (total / allReviews.length).toFixed(1);
    }
%>

<style>
        /* ===== LUXURY AIRBNB MAP POPUP STYLES ===== */
    .mapboxgl-popup {
        max-width: 250px !important;
    }
    .mapboxgl-popup-content {
        border-radius: 16px !important;
        padding: 0 !important;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18), 0 2px 8px rgba(0, 0, 0, 0.08) !important;
        border: 1px solid rgba(0, 0, 0, 0.06);
        font-family: 'DM Sans', sans-serif;
    }
    .mapboxgl-popup-close-button {
        top: 8px !important;
        right: 8px !important;
        width: 26px;
        height: 26px;
        background: rgba(255, 255, 255, 0.9) !important;
        backdrop-filter: blur(4px);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        color: #222222;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
        border: none;
        outline: none;
        z-index: 10;
        transition: transform 0.15s ease;
    }
    .mapboxgl-popup-close-button:hover {
        transform: scale(1.1);
        background: #ffffff !important;
    }
    .popup-card-img-wrap {
        position: relative;
        width: 100%;
        height: 120px;
        background: #f0f0f0;
    }
    .popup-card-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .popup-rating-badge {
        position: absolute;
        bottom: 8px;
        left: 8px;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(4px);
        padding: 3px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
        color: #1a1a2e;
        display: flex;
        align-items: center;
        gap: 3px;
    }
    .popup-card-body {
        padding: 12px 14px 14px;
    }
    .popup-card-title {
        font-size: 14px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .popup-card-location {
        font-size: 12px;
        color: #717171;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .popup-card-footer {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        border-top: 1px solid #f0f0f0;
        padding-top: 8px;
    }
    .popup-card-price {
        font-size: 13px;
        color: #1a1a2e;
    }
    .popup-card-price strong {
        font-weight: 700;
        font-size: 14px;
    }
    .popup-note-tag {
        font-size: 10px;
        color: #FF385C;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }
    .show-page-wrapper {
        max-width: 1120px;
        margin: 0 auto;
    }
    .listing-hero-img {
        width: 100%;
        height: 460px;
        object-fit: cover;
    }
    @media (max-width: 768px) {
        .listing-hero-img {
            height: 280px;
        }
    }
    .btn-airbnb-primary {
        background: linear-gradient(135deg, #FF385C, #D70466);
        color: #ffffff;
        border: none;
        transition: transform 0.15s ease, opacity 0.15s ease;
    }
    .btn-airbnb-primary:hover {
        opacity: 0.95;
        transform: translateY(-1px);
        color: #ffffff;
    }
    .star-picker i {
        cursor: pointer;
        transition: transform 0.15s ease;
    }
    .star-picker i:hover {
        transform: scale(1.2);
    }
    .sticky-card {
        top: 100px;
    }
    /* Responsive Map Container */
    #map {
        width: 100%;
        height: 420px;
        border-radius: 16px;
    }
    .mapboxgl-popup-content {
        border-radius: 12px;
        padding: 14px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
        font-family: 'DM Sans', sans-serif;
    }
</style>

<div class="container show-page-wrapper py-4">

    <!-- 1. Back Link -->
    <div class="mb-3">
        <a href="/" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 fw-semibold">
            <i class="fa-solid fa-arrow-left me-1"></i> All Listings
        </a>
    </div>

    <!-- 2. Listing Title & Meta -->
    <div class="mb-3">
        <h1 class="fw-bold text-dark mb-2" style="font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3.5vw, 2.4rem);">
            <%= listing.title %>
        </h1>
        <div class="d-flex align-items-center flex-wrap gap-2 text-muted small">
            <span class="fw-bold text-dark d-flex align-items-center gap-1">
                <i class="fa-solid fa-star text-warning"></i>
                <%= allReviews.length > 0 ? avgRating : 'New' %>
            </span>
            <span>·</span>
            <span><%= allReviews.length %> review<%= allReviews.length === 1 ? '' : 's' %></span>
            <span>·</span>
            <span class="text-decoration-underline text-dark fw-semibold">
                <i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %>
            </span>
        </div>
    </div>

    <!-- 3. Hero Image -->
    <div class="mb-4 overflow-hidden rounded-4 shadow-sm bg-light">
        <img src="<%= (listing.image && listing.image.url) ? listing.image.url : listing.image %>" alt="<%= listing.title %>" class="listing-hero-img d-block" loading="lazy">
    </div>

    <!-- 4. Host Controls (Edit / Delete) -->
    <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id || listing.owner)) { %>
        <div class="card border rounded-4 p-3 mb-4 shadow-sm bg-white">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2 fw-bold text-secondary small">
                    <i class="fa-solid fa-sliders text-danger"></i> Listing Controls
                </div>
                <div class="d-flex gap-2">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-dark rounded-3 px-3 fw-semibold">
                        <i class="fa-regular fa-pen-to-square me-1"></i> Edit
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-3 px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#deleteListingModal">
                        <i class="fa-regular fa-trash-can me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    <% } %>

    <!-- 5. Main 2-Column Grid -->
    <div class="row g-4 mb-5">
        
        <!-- Left Column: Details -->
        <div class="col-lg-8">

            <!-- Host Info Block -->
            <div class="d-flex align-items-center gap-3 pb-4 mb-4 border-bottom">
                <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center shadow-sm fw-bold flex-shrink-0"
                     style="width: 52px; height: 52px; font-size: 1.25rem;">
                    <% if (listing.owner && listing.owner.username) { %>
                        <%= listing.owner.username.charAt(0).toUpperCase() %>
                    <% } else { %>
                        <i class="fa-solid fa-user" style="font-size: 1.1rem;"></i>
                    <% } %>
                </div>
                <div>
                    <h5 class="fw-bold mb-1 text-dark" style="font-family: 'DM Sans', sans-serif;">
                        Hosted by <%= (listing.owner && listing.owner.username) ? listing.owner.username : 'Property Host' %>
                    </h5>
                    <div class="d-flex align-items-center flex-wrap gap-2 text-muted small">
                        <span class="badge bg-light text-dark border px-2 py-1">
                            <i class="fa-solid fa-shield-halved text-danger me-1"></i> Identity verified
                        </span>
                        <span>·</span>
                        <span class="d-flex align-items-center gap-1">
                            <i class="fa-solid fa-medal text-warning"></i> Superhost
                        </span>
                    </div>
                </div>
            </div>

            <!-- Highlights -->
            <div class="pb-4 mb-4 border-bottom">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <i class="fa-solid fa-door-open fs-5 text-dark mt-1"></i>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">Self check-in</h6>
                        <small class="text-secondary">Check yourself in with the digital keypad.</small>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-3 mb-3">
                    <i class="fa-solid fa-calendar-check fs-5 text-dark mt-1"></i>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">Free cancellation</h6>
                        <small class="text-secondary">Cancel up to 48 hours before check-in for a full refund.</small>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-3">
                    <i class="fa-solid fa-medal fs-5 text-dark mt-1"></i>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">Experienced Superhost</h6>
                        <small class="text-secondary">Highly rated host committed to great stays.</small>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="pb-4 mb-4">
                <h4 class="fw-bold text-dark mb-3" style="font-family: 'DM Sans', sans-serif;">About this place</h4>
                <p class="text-secondary lh-lg mb-0" style="font-size: 15px; word-break: break-word;">
                    <%= listing.description %>
                </p>
            </div>

        </div>

        <!-- Right Column: Sticky Booking Card -->
        <div class="col-lg-4">
            <div class="card border rounded-4 shadow-sm p-4 sticky-top sticky-card bg-white">
                <div class="d-flex align-items-baseline justify-content-between mb-3">
                    <div>
                        <span class="fs-4 fw-bold text-dark">&#8377;<%= listing.price ? listing.price.toLocaleString('en-IN') : '0' %></span>
                        <span class="text-muted small"> / night</span>
                    </div>
                    <div class="small fw-bold text-dark d-flex align-items-center gap-1">
                        <i class="fa-solid fa-star text-warning"></i>
                        <%= allReviews.length > 0 ? avgRating : 'New' %>
                    </div>
                </div>

                <!-- Dates Picker Box -->
                <div class="border rounded-3 overflow-hidden mb-3">
                    <div class="row g-0 border-bottom">
                        <div class="col-6 p-2 border-end">
                            <div class="text-uppercase text-muted fw-bold" style="font-size: 9px; letter-spacing: 0.5px;">Check-in</div>
                            <div class="small text-dark fw-semibold">Add date</div>
                        </div>
                        <div class="col-6 p-2">
                            <div class="text-uppercase text-muted fw-bold" style="font-size: 9px; letter-spacing: 0.5px;">Checkout</div>
                            <div class="small text-dark fw-semibold">Add date</div>
                        </div>
                    </div>
                    <div class="p-2">
                        <div class="text-uppercase text-muted fw-bold" style="font-size: 9px; letter-spacing: 0.5px;">Guests</div>
                        <div class="small text-dark fw-semibold">1 guest</div>
                    </div>
                </div>

                <button class="btn btn-airbnb-primary rounded-3 w-100 py-3 fw-bold shadow-sm mb-2">
                    Reserve Now
                </button>
                <p class="text-center text-muted small mb-0" style="font-size: 12px;">You won't be charged yet</p>
            </div>
        </div>

    </div>

    <!-- 6. MAP SECTION (Where you'll be) -->
    <div class="pt-5 border-top mb-5">
        <h4 class="fw-bold text-dark mb-1" style="font-family: 'DM Sans', sans-serif;">Where you'll be</h4>
        <p class="text-secondary small mb-3">
            <i class="fa-solid fa-location-dot text-danger me-1"></i>
            <%= listing.location %>, <%= listing.country %>
        </p>
        <div class="shadow-sm rounded-4 overflow-hidden border">
            <div id="map"></div>
        </div>
    </div>

    <!-- 7. Reviews Section -->
    <div class="pt-4 border-top">
        
        <!-- Header -->
        <div class="d-flex align-items-center gap-2 mb-4">
            <i class="fa-solid fa-star text-warning fs-4"></i>
            <h3 class="fw-bold mb-0 text-dark" style="font-family: 'DM Sans', sans-serif;">
                <% if (allReviews.length > 0) { %>
                    <%= avgRating %> · <%= allReviews.length %> Review<%= allReviews.length === 1 ? '' : 's' %>
                <% } else { %>
                    Guest Reviews
                <% } %>
            </h3>
        </div>

        <!-- Add Review Form -->
        <% if (currUser) { %>
            <div class="card border rounded-4 p-4 mb-5 shadow-sm bg-white">
                <h5 class="fw-bold text-dark mb-3">Leave a Review</h5>
                <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                    
                    <input type="hidden" name="review[rating]" id="ratingInput" value="5">

                    <!-- Interactive Star Rating Picker -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small mb-1">Your Rating</label>
                        <div class="d-flex align-items-center gap-3">
                            <div class="star-picker text-warning fs-4" id="starContainer">
                                <i class="fa-solid fa-star star-icon" data-value="1"></i>
                                <i class="fa-solid fa-star star-icon" data-value="2"></i>
                                <i class="fa-solid fa-star star-icon" data-value="3"></i>
                                <i class="fa-solid fa-star star-icon" data-value="4"></i>
                                <i class="fa-solid fa-star star-icon" data-value="5"></i>
                            </div>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fw-bold" id="ratingBadge">
                                5.0 · Excellent
                            </span>
                        </div>
                    </div>

                    <!-- Comment -->
                    <div class="mb-3">
                        <label for="comment" class="form-label fw-bold text-dark small mb-1">Comment</label>
                        <textarea class="form-control rounded-3 p-3" name="review[comment]" id="comment" rows="3" placeholder="Share your experience staying here (amenities, cleanliness, location)..." required></textarea>
                        <div class="invalid-feedback">
                            Please write a short comment for your review.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-dark rounded-3 px-4 py-2 fw-semibold">
                        Submit Review
                    </button>
                </form>
            </div>
        <% } else { %>
            <div class="card border rounded-4 p-4 text-center my-4 bg-light shadow-sm">
                <div class="card-body py-3">
                    <div class="mb-2 fs-2 text-secondary">
                        <i class="fa-solid fa-user-lock"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Log in to leave a review</h5>
                    <p class="text-secondary small mb-3">You need to be logged in to submit a review for this property.</p>
                    <a href="/login" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold btn-sm">
                        <i class="fa-solid fa-right-to-bracket me-1"></i> Log In
                    </a>
                </div>
            </div>
        <% } %>

        <!-- Reviews Grid -->
        <% if (allReviews.length > 0) { %>
            <div class="row g-4">
                <% allReviews.forEach(function(review) { %>
                    <div class="col-md-6 col-12">
                        <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white">
                            
                            <!-- Review Header -->
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0"
                                         style="width: 44px; height: 44px; font-size: 1rem;">
                                        <% if (review.user && review.user.username) { %>
                                            <%= review.user.username.charAt(0).toUpperCase() %>
                                        <% } else { %>
                                            <i class="fa-solid fa-user" style="font-size: 0.9rem;"></i>
                                        <% } %>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">
                                            <%= (review.user && review.user.username) ? review.user.username : 'Verified Guest' %>
                                        </h6>
                                        <small class="text-muted" style="font-size: 12px;">
                                            <%= review.createdAt ? new Date(review.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : 'Recent stay' %>
                                        </small>
                                    </div>
                                </div>

                                <!-- Delete Review Trigger -->
                                <% if (currUser && review.user && currUser._id.equals(review.user._id || review.user)) { %>
                                    <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2 open-delete-review-btn" 
                                            data-review-id="<%= review._id %>" title="Delete Review">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </button>
                                <% } %>
                            </div>

                            <!-- Star Rating -->
                            <% const rScore = Math.round(Number(review.rating) || 5); %>
                            <div class="d-flex align-items-center gap-1 text-warning small mb-2">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <% if (i <= rScore) { %>
                                        <i class="fa-solid fa-star"></i>
                                    <% } else { %>
                                        <i class="fa-regular fa-star text-secondary opacity-50"></i>
                                    <% } %>
                                <% } %>
                                <span class="fw-bold text-dark ms-2 small">
                                    <%= (review.rating && !isNaN(review.rating)) ? Number(review.rating).toFixed(1) : '5.0' %>
                                </span>
                            </div>

                            <!-- Comment Text -->
                            <p class="text-secondary small mb-0 lh-base" style="word-break: break-word;">
                                <%= review.comment || 'No comment provided.' %>
                            </p>

                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="card border rounded-4 p-5 text-center my-3 bg-light">
                <div class="mb-2 text-secondary fs-3">
                    <i class="fa-regular fa-comment-dots"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">No reviews yet</h6>
                <p class="text-secondary small mb-0">Be the first to share your thoughts on this place!</p>
            </div>
        <% } %>

    </div>

</div>

<!-- 8. Bootstrap Modal: Delete Listing -->
<div class="modal fade" id="deleteListingModal" tabindex="-1" aria-labelledby="deleteListingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4">
                <div class="rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 56px; height: 56px; font-size: 24px;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Delete this listing?</h5>
                <p class="text-secondary small mb-4">
                    Are you sure you want to permanently delete <strong>"<%= listing.title %>"</strong>? This action cannot be undone.
                </p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0">
                        <button type="submit" class="btn btn-danger rounded-3 px-4 fw-semibold">Yes, Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 9. Bootstrap Modal: Delete Review -->
<div class="modal fade" id="deleteReviewModal" tabindex="-1" aria-labelledby="deleteReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4">
                <div class="rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 56px; height: 56px; font-size: 24px;">
                    <i class="fa-solid fa-trash-can"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Delete this review?</h5>
                <p class="text-secondary small mb-4">
                    Are you sure you want to remove your review? This action cannot be undone.
                </p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <form id="deleteReviewForm" method="POST" action="" class="m-0">
                        <button type="submit" class="btn btn-danger rounded-3 px-4 fw-semibold">Yes, Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script>
    // 1. Mapbox Map Rendering with Safe Coordinate Fallback
    (function() {
        const mapToken = "<%= process.env.MAP_TOKEN %>";
        mapboxgl.accessToken = mapToken;

        // Default to New Delhi coordinates [lng, lat] if listing has no geometry yet
        const coordinates = <%- JSON.stringify(listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length ? listing.geometry.coordinates : [77.2090, 28.6139]) %>;

        const map = new mapboxgl.Map({
            container: 'map',
            style: 'mapbox://styles/mapbox/streets-v12',
            center: coordinates, // [lng, lat]
            zoom: 10
        });

        // Add Zoom Controls
        map.addControl(new mapboxgl.NavigationControl(), 'top-right');

        // Add Coral Marker with Popup
               // Airbnb Mini Preview Card Popup
        const popup = new mapboxgl.Popup({ offset: 25, closeButton: true })
            .setHTML(`
                <div class="popup-card">
                    <div class="popup-card-img-wrap">
                        <img src="<%= (listing.image && listing.image.url) ? listing.image.url : listing.image %>" alt="<%= listing.title %>">
                        <span class="popup-rating-badge">
                            <i class="fa-solid fa-star text-warning" style="font-size: 10px;"></i>
                            <%= allReviews.length > 0 ? avgRating : 'New' %>
                        </span>
                    </div>
                    <div class="popup-card-body">
                        <div class="popup-card-title" title="<%= listing.title %>"><%= listing.title %></div>
                        <div class="popup-card-location">
                            <i class="fa-solid fa-location-dot text-danger" style="font-size: 11px;"></i>
                            <%= listing.location %>, <%= listing.country %>
                        </div>
                        <div class="popup-card-footer">
                            <div class="popup-card-price">
                                <strong>&#8377;<%= listing.price ? listing.price.toLocaleString('en-IN') : '0' %></strong>
                                <span class="text-muted" style="font-size: 11px;">/ night</span>
                            </div>
                            <span class="popup-note-tag">Exact on booking</span>
                        </div>
                    </div>
                </div>
            `);

        new mapboxgl.Marker({ color: '#FF385C' })
            .setLngLat(coordinates)
            .setPopup(popup)
            .addTo(map);
    })();

    // 2. Interactive Star Rating Selector
    (function() {
        const starContainer = document.getElementById('starContainer');
        const ratingInput = document.getElementById('ratingInput');
        const ratingBadge = document.getElementById('ratingBadge');

        if (!starContainer || !ratingInput) return;

        const stars = starContainer.querySelectorAll('.star-icon');
        const descriptions = {
            1: "1.0 · Poor",
            2: "2.0 · Fair",
            3: "3.0 · Average",
            4: "4.0 · Very Good",
            5: "5.0 · Excellent"
        };

        let currentRating = parseInt(ratingInput.value) || 5;

        function updateStars(val) {
            stars.forEach(star => {
                const sVal = parseInt(star.getAttribute('data-value'));
                if (sVal <= val) {
                    star.className = 'fa-solid fa-star star-icon';
                } else {
                    star.className = 'fa-regular fa-star star-icon';
                }
            });
            if (ratingBadge && descriptions[val]) {
                ratingBadge.textContent = descriptions[val];
            }
        }

        stars.forEach(star => {
            star.addEventListener('mouseenter', () => {
                updateStars(parseInt(star.getAttribute('data-value')));
            });
            star.addEventListener('click', () => {
                currentRating = parseInt(star.getAttribute('data-value'));
                ratingInput.value = currentRating;
                updateStars(currentRating);
            });
        });

        starContainer.addEventListener('mouseleave', () => {
            updateStars(currentRating);
        });

        updateStars(currentRating);
    })();

    // 3. Review Delete Modal Handler
    document.addEventListener('DOMContentLoaded', function() {
        const deleteReviewForm = document.getElementById('deleteReviewForm');
        const deleteReviewBtns = document.querySelectorAll('.open-delete-review-btn');
        const reviewModalEl = document.getElementById('deleteReviewModal');

        if (!reviewModalEl || !deleteReviewForm) return;

        const reviewModal = new bootstrap.Modal(reviewModalEl);

        deleteReviewBtns.forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const reviewId = this.getAttribute('data-review-id');
                deleteReviewForm.action = `/listings/<%= listing._id %>/reviews/${reviewId}?_method=DELETE`;
                reviewModal.show();
            });
        });
    });

    // 4. Form Validation Script
    (() => {
        'use strict';
        const forms = document.querySelectorAll('.needs-validation');
        Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>