<% layout('/layouts/boilerplate') -%>

<%
    // Calculate live average rating from actual database reviews
    const allReviews = (listing.reviews && listing.reviews.length > 0) ? listing.reviews : [];
    let avgRating = 0;
    if (allReviews.length > 0) {
        let total = allReviews.reduce((acc, curr) => acc + (Number(curr.rating) || 0), 0);
        avgRating = (total / allReviews.length).toFixed(1);
    }
%>

<style>
    /* ===== PAGE WRAPPER ===== */
    .show-wrapper {
        padding: 24px 48px 60px;
        max-width: 1120px;
        margin: 0 auto;
        box-sizing: border-box;
        width: 100%;
    }

    /* ===== BACK BUTTON ===== */
    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #717171;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 20px;
        padding: 6px 12px;
        border-radius: 8px;
        background: #ffffff;
        border: 1px solid #ebebeb;
        width: fit-content;
        transition: all 0.2s ease;
    }

    .back-btn:hover {
        color: #FF385C;
        border-color: #FF385C;
        background: #fff5f7;
        transform: translateX(-3px);
    }

    /* ===== TITLE & SUBTITLE ===== */
    .show-header {
        margin-bottom: 20px;
    }

    .listing-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(24px, 4vw, 34px);
        font-weight: 800;
        color: #1a1a2e;
        margin-bottom: 8px;
        line-height: 1.25;
        word-break: break-word;
    }

    .listing-subtitle {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        color: #555555;
    }

    .rating-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 700;
        color: #1a1a2e;
    }

    .rating-badge i {
        color: #FFB400;
        font-size: 13px;
    }

    .location-link {
        color: #222222;
        font-weight: 600;
        text-decoration: underline;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .location-link i {
        color: #FF385C;
        font-size: 13px;
    }

    /* ===== HERO IMAGE ===== */
    .image-container {
        width: 100%;
        height: 440px;
        border-radius: 18px;
        overflow: hidden;
        margin-bottom: 28px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        background: #f0f0f0;
    }

    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* ===== HOST ACTION BAR (EDIT & DELETE) ===== */
    .host-actions-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 32px;
        padding: 14px 20px;
        background: #ffffff;
        border: 1px solid #ebebeb;
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .host-actions-title {
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: #717171;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .host-actions-btns {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-action-edit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        background: #1a1a2e;
        color: #ffffff;
        text-decoration: none;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .btn-action-edit:hover {
        background: #333333;
        transform: translateY(-1px);
        color: #ffffff;
    }

    .btn-action-delete {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        background: #ffffff;
        color: #dc2626;
        border: 1px solid #fecaca;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-action-delete:hover {
        background: #fef2f2;
        border-color: #dc2626;
        transform: translateY(-1px);
    }

    /* ===== MAIN TWO-COLUMN GRID ===== */
    .content-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 48px;
        margin-bottom: 48px;
    }

    .details-left {
        display: flex;
        flex-direction: column;
        gap: 28px;
        min-width: 0;
    }

    .host-card {
        display: flex;
        align-items: center;
        gap: 16px;
        padding-bottom: 24px;
        border-bottom: 1px solid #ebebeb;
    }

    .host-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1a1a2e, #3a3a5e);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .host-card-info h3 {
        font-family: 'DM Sans', sans-serif;
        font-size: 18px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 2px;
    }

    .host-card-info p {
        font-size: 13px;
        color: #717171;
        margin-bottom: 0;
    }

    .highlights {
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding-bottom: 28px;
        border-bottom: 1px solid #ebebeb;
    }

    .highlight-item {
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

    .highlight-item i {
        font-size: 20px;
        color: #1a1a2e;
        width: 24px;
        text-align: center;
        margin-top: 2px;
        flex-shrink: 0;
    }

    .highlight-text h4 {
        font-family: 'DM Sans', sans-serif;
        font-size: 15px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 2px;
    }

    .highlight-text p {
        font-size: 13px;
        color: #717171;
        margin: 0;
    }

    .about-place h3 {
        font-family: 'DM Sans', sans-serif;
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 12px;
        color: #1a1a2e;
    }

    .about-place p {
        font-size: 15px;
        line-height: 1.7;
        color: #484848;
        word-break: break-word;
        margin: 0;
    }

    /* ===== RIGHT STICKY PRICE CARD ===== */
    .price-card {
        position: sticky;
        top: 100px;
        height: fit-content;
        background: #ffffff;
        border: 1px solid #dddddd;
        border-radius: 16px;
        padding: 26px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        box-sizing: border-box;
    }

    .price-card-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 20px;
    }

    .price-amount {
        font-family: 'DM Sans', sans-serif;
        font-size: 24px;
        font-weight: 700;
        color: #1a1a2e;
    }

    .price-night {
        font-size: 14px;
        color: #717171;
        font-weight: 400;
    }

    .booking-box {
        border: 1px solid #b0b0b0;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 18px;
    }

    .booking-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-bottom: 1px solid #b0b0b0;
    }

    .booking-cell {
        padding: 10px 14px;
    }

    .booking-cell:first-child {
        border-right: 1px solid #b0b0b0;
    }

    .booking-cell label {
        display: block;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        color: #222222;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }

    .booking-cell span {
        font-size: 13px;
        color: #717171;
    }

    .reserve-btn {
        width: 100%;
        padding: 14px;
        background: linear-gradient(135deg, #FF385C, #D70466);
        color: #ffffff;
        border: none;
        border-radius: 10px;
        font-family: 'DM Sans', sans-serif;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: opacity 0.2s ease, transform 0.2s ease;
        box-shadow: 0 4px 14px rgba(255, 56, 92, 0.25);
    }

    .reserve-btn:hover {
        opacity: 0.95;
        transform: translateY(-1px);
    }

    .price-note {
        text-align: center;
        font-size: 12px;
        color: #717171;
        margin-top: 12px;
        margin-bottom: 0;
    }

    /* ===== REVIEWS SECTION ===== */
    .reviews-section {
        padding-top: 40px;
        border-top: 1px solid #ebebeb;
        margin-top: 20px;
    }

    .reviews-header {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'DM Sans', sans-serif;
        font-size: 22px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 24px;
    }

    .reviews-header i {
        color: #FFB400;
        font-size: 20px;
    }

    /* ===== REVIEW FORM CARD ===== */
    .review-form-card {
        background: #ffffff;
        border: 1px solid #ebebeb;
        border-radius: 18px;
        padding: 28px;
        margin-bottom: 36px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    }

    .review-form-title {
        font-family: 'DM Sans', sans-serif;
        font-size: 18px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 16px;
    }

    .star-rating-box {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 26px;
        color: #FFB400;
        cursor: pointer;
        user-select: none;
    }

    .star-rating-box i {
        transition: transform 0.15s ease;
    }

    .star-rating-box i:hover {
        transform: scale(1.15);
    }

    .rating-live-badge {
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 20px;
        background: #fff8eb;
        color: #b45309;
        border: 1px solid #fef3c7;
    }

    /* ===== REVIEW DISPLAY CARDS ===== */
    .review-item-card {
        background: #ffffff;
        border: 1px solid #ebebeb;
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .review-item-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.07);
    }

    .review-stars-row {
        color: #FFB400;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 3px;
        margin-bottom: 12px;
    }

    .review-stars-score {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 13px;
        color: #1a1a2e;
        margin-left: 6px;
    }

    .review-user-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1a1a2e, #475569);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
    }

    .review-text-content {
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        color: #4b5563;
        line-height: 1.6;
        word-break: break-word;
        margin: 0;
    }

    .btn-review-delete {
        background: none;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        font-size: 14px;
        padding: 6px 9px;
        border-radius: 6px;
        transition: all 0.2s ease;
    }

    .btn-review-delete:hover {
        color: #dc2626;
        background: #fef2f2;
    }

    /* ===== WHERE YOU'LL BE ===== */
    .location-section {
        padding-top: 40px;
        border-top: 1px solid #ebebeb;
        margin-top: 40px;
    }

    .location-section h3 {
        font-family: 'DM Sans', sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 12px;
    }

    .location-detail {
        font-size: 15px;
        color: #555555;
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }

    .location-detail i {
        color: #FF385C;
        font-size: 16px;
    }

    /* ===== REUSABLE POP-UP MODAL (LISTING & REVIEWS) ===== */
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        padding: 16px;
        box-sizing: border-box;
    }

    .modal-backdrop.show-modal {
        display: flex;
        animation: modalFadeIn 0.2s ease-out;
    }

    .modal-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 32px 24px;
        max-width: 420px;
        width: 100%;
        text-align: center;
        position: relative;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
        animation: modalPopUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        box-sizing: border-box;
    }

    @keyframes modalPopUp {
        from { opacity: 0; transform: scale(0.92) translateY(12px); }
        to   { opacity: 1; transform: scale(1) translateY(0); }
    }

    @keyframes modalFadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    .modal-close-btn {
        position: absolute;
        top: 16px;
        right: 16px;
        background: none;
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #717171;
        font-size: 16px;
        transition: background 0.2s;
    }

    .modal-close-btn:hover {
        background: #f7f7f7;
        color: #222222;
    }

    .modal-icon-wrap {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: #FEE2E2;
        color: #DC2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin: 0 auto 16px;
    }

    .modal-title {
        font-family: 'DM Sans', sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 8px;
    }

    .modal-desc {
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        color: #666666;
        line-height: 1.6;
        margin-bottom: 24px;
    }

    .modal-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .btn-modal-cancel {
        padding: 12px;
        background: #f1f5f9;
        color: #475569;
        border: none;
        border-radius: 10px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-modal-cancel:hover {
        background: #e2e8f0;
    }

    .btn-modal-confirm {
        width: 100%;
        padding: 12px;
        background: #DC2626;
        color: #ffffff;
        border: none;
        border-radius: 10px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
        transition: all 0.2s;
    }

    .btn-modal-confirm:hover {
        background: #b91c1c;
        transform: translateY(-1px);
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 1024px) {
        .show-wrapper {
            padding: 24px 32px 60px;
        }

        .content-grid {
            grid-template-columns: 1fr 340px;
            gap: 32px;
        }

        .image-container {
            height: 380px;
        }
    }

    @media (max-width: 850px) {
        .content-grid {
            grid-template-columns: 1fr;
            gap: 36px;
        }

        .price-card {
            position: static;
        }
    }

    @media (max-width: 600px) {
        .show-wrapper {
            padding: 16px 16px 48px;
        }

        .image-container {
            height: 250px;
            border-radius: 14px;
            margin-bottom: 20px;
        }

        .host-actions-bar {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }

        .host-actions-btns {
            width: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .btn-action-edit, .btn-action-delete {
            justify-content: center;
        }

        .review-form-card {
            padding: 20px 16px;
        }
    }
</style>

<div class="show-wrapper">

    <!-- Back Button -->
    <a href="/listings" class="back-btn">
        <i class="fa-solid fa-arrow-left"></i> All Listings
    </a>

    <!-- Title and Subtitle with Dynamic Rating -->
    <div class="show-header">
        <h1 class="listing-title"><%= listing.title %></h1>
        <div class="listing-subtitle">
            <span class="rating-badge">
                <% if (allReviews.length > 0) { %>
                    <i class="fa-solid fa-star"></i> <%= avgRating %> · <%= allReviews.length %> review<%= allReviews.length > 1 ? 's' : '' %>
                <% } else { %>
                    <i class="fa-regular fa-star" style="color: #FFB400;"></i> New (No reviews yet)
                <% } %>
            </span>
            <span>·</span>
            <span class="location-link">
                <i class="fa-solid fa-location-dot"></i>
                <%= listing.location %>, <%= listing.country %>
            </span>
        </div>
    </div>

    <!-- Hero Image -->
    <div class="image-container">
        <img src="<%= listing.image %>" alt="<%= listing.title %>" loading="lazy">
    </div>

    <!-- Host Actions Bar -->
    <div class="host-actions-bar">
        <span class="host-actions-title">
            <i class="fa-solid fa-sliders"></i> Listing Controls
        </span>
        <div class="host-actions-btns">
            <a href="/listings/<%= listing._id %>/edit" class="btn-action-edit">
                <i class="fa-regular fa-pen-to-square"></i> Edit
            </a>
            <button type="button" class="btn-action-delete" id="openDeleteModalBtn">
                <i class="fa-regular fa-trash-can"></i> Delete
            </button>
        </div>
    </div>

    <!-- Content Grid: Left details + Right price card -->
    <div class="content-grid">

        <!-- Left Column -->
        <div class="details-left">
            <div class="host-card">
                <div class="host-avatar">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div class="host-card-info">
                    <h3>Hosted by Property Host</h3>
                    <p>Superhost · 3 years hosting experience</p>
                </div>
            </div>

            <div class="highlights">
                <div class="highlight-item">
                    <i class="fa-solid fa-door-open"></i>
                    <div class="highlight-text">
                        <h4>Self check-in</h4>
                        <p>Check yourself in with the digital keypad.</p>
                    </div>
                </div>
                <div class="highlight-item">
                    <i class="fa-solid fa-calendar-check"></i>
                    <div class="highlight-text">
                        <h4>Free cancellation</h4>
                        <p>Cancel up to 48 hours before check-in for a full refund.</p>
                    </div>
                </div>
                <div class="highlight-item">
                    <i class="fa-solid fa-medal"></i>
                    <div class="highlight-text">
                        <h4>Superhost</h4>
                        <p>Superhosts are experienced and highly rated hosts.</p>
                    </div>
                </div>
            </div>

            <div class="about-place">
                <h3>About this place</h3>
                <p><%= listing.description %></p>
            </div>
        </div>

        <!-- Right Column: Sticky Booking Card -->
        <div>
            <div class="price-card">
                <div class="price-card-header">
                    <div>
                        <span class="price-amount">&#8377;<%= listing.price.toLocaleString('en-IN') %></span>
                        <span class="price-night"> / night</span>
                    </div>
                    <span class="rating-badge">
                        <i class="fa-solid fa-star"></i> <%= allReviews.length > 0 ? avgRating : 'New' %>
                    </span>
                </div>

                <div class="booking-box">
                    <div class="booking-row">
                        <div class="booking-cell">
                            <label>Check-in</label>
                            <span>Add date</span>
                        </div>
                        <div class="booking-cell">
                            <label>Checkout</label>
                            <span>Add date</span>
                        </div>
                    </div>
                    <div class="booking-cell">
                        <label>Guests</label>
                        <span>1 guest</span>
                    </div>
                </div>

                <button class="reserve-btn">Reserve Now</button>
                <p class="price-note">You won't be charged yet</p>
            </div>
        </div>

    </div>

    <!-- ===== REVIEWS SECTION ===== -->
    <div class="reviews-section">
        <div class="reviews-header">
            <i class="fa-solid fa-star"></i>
            <span>
                <% if (allReviews.length > 0) { %>
                    <%= avgRating %> · <%= allReviews.length %> Review<%= allReviews.length > 1 ? 's' : '' %>
                <% } else { %>
                    Guest Reviews
                <% } %>
            </span>
        </div>

        <!-- Leave a Review Form Card -->
        <div class="review-form-card" id="reviewFormSection">
            <h4 class="review-form-title">Leave a Review</h4>
            
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                
                <!-- Hidden input storing review[rating] for backend -->
                <input type="hidden" name="review[rating]" id="ratingInput" value="5">

                <!-- Interactive Star Rating Picker -->
                <div class="mb-4">
                    <label class="form-label fw-bold text-dark small mb-2">Your Rating</label>
                    <div class="d-flex align-items-center gap-3">
                        <div class="star-rating-box" id="starContainer">
                            <i class="fa-solid fa-star star-icon" data-value="1"></i>
                            <i class="fa-solid fa-star star-icon" data-value="2"></i>
                            <i class="fa-solid fa-star star-icon" data-value="3"></i>
                            <i class="fa-solid fa-star star-icon" data-value="4"></i>
                            <i class="fa-solid fa-star star-icon" data-value="5"></i>
                        </div>
                        <span class="rating-live-badge" id="ratingBadge">5.0 · Excellent</span>
                    </div>
                </div>

                <!-- Comment Input -->
                <div class="mb-3">
                    <label for="comment" class="form-label fw-bold text-dark small mb-2">Comment</label>
                    <textarea class="form-control rounded-3 p-3" name="review[comment]" id="comment" rows="3" placeholder="Share your experience staying here (amenities, cleanliness, location)..." required></textarea>
                    <div class="invalid-feedback">
                        Please write a short comment for your review.
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-dark rounded-3 px-4 py-2 fw-semibold">
                    Submit Review
                </button>
            </form>
        </div>

        <!-- Reviews Grid -->
        <% if (allReviews.length > 0) { %>
            <div class="row g-4 mb-4">
                <% allReviews.forEach(function(review) { %>
                    <div class="col-md-6">
                        <div class="review-item-card">
                            <div>
                                <!-- Top Row: Avatar, Date, Pop-up Delete button -->
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="review-user-avatar">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-0 text-dark">Verified Guest</h6>
                                            <small class="text-secondary" style="font-size: 12px;">
                                                <%= review.createdAt ? new Date(review.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : 'Recent stay' %>
                                            </small>
                                        </div>
                                    </div>

                                    <!-- Pop-up Modal Trigger for Review Delete -->
                                    <button type="button" class="btn-review-delete open-review-delete-btn" data-review-id="<%= review._id %>" title="Delete Review">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </button>
                                </div>

                                <!-- Star Rating Display (Safe from NaN) -->
                                <% const rScore = Math.round(Number(review.rating) || 5); %>
                                <div class="review-stars-row">
                                    <% for (let i = 1; i <= 5; i++) { %>
                                        <% if (i <= rScore) { %>
                                            <i class="fa-solid fa-star"></i>
                                        <% } else { %>
                                            <i class="fa-regular fa-star" style="color: #d1d5db;"></i>
                                        <% } %>
                                    <% } %>
                                    <span class="review-stars-score">
                                        <%= (review.rating && !isNaN(review.rating)) ? Number(review.rating).toFixed(1) : '5.0' %>
                                    </span>
                                </div>

                                <!-- Review Comment Text -->
                                <p class="review-text-content"><%= review.comment || 'No comment provided.' %></p>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <!-- Empty State -->
            <div class="card border border-light-subtle rounded-4 p-4 text-center my-4 bg-light">
                <div class="card-body py-4">
                    <div class="mb-3" style="font-size: 2.5rem; color: #94a3b8;">
                        <i class="fa-regular fa-comment-dots"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">No reviews yet</h5>
                    <p class="text-secondary mb-3" style="max-width: 420px; margin: 0 auto; font-size: 14px;">
                        Be the first to share your thoughts and help future guests know what to expect!
                    </p>
                    <a href="#reviewFormSection" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold">
                        <i class="fa-regular fa-pen-to-square me-1"></i> Add a Review
                    </a>
                </div>
            </div>
        <% } %>

    </div>

    <!-- Location Section -->
    <div class="location-section">
        <h3>Where you'll be</h3>
        <p class="location-detail">
            <i class="fa-solid fa-map-location-dot"></i>
            <%= listing.location %>, <%= listing.country %>
        </p>
    </div>

    <!-- 1. DELETE LISTING POP-UP MODAL -->
    <div class="modal-backdrop" id="deleteModalBackdrop">
        <div class="modal-card">
            <button type="button" class="modal-close-btn" id="closeModalBtn" aria-label="Close modal">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="modal-icon-wrap">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3 class="modal-title">Delete this listing?</h3>
            <p class="modal-desc">
                Are you sure you want to permanently delete <strong>"<%= listing.title %>"</strong>? This action cannot be undone.
            </p>
            <div class="modal-actions">
                <button type="button" class="btn-modal-cancel" id="cancelDeleteBtn">Cancel</button>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" style="display:inline;">
                    <button type="submit" class="btn-modal-confirm">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>

    <!-- 2. DELETE REVIEW POP-UP MODAL -->
    <div class="modal-backdrop" id="deleteReviewModalBackdrop">
        <div class="modal-card">
            <button type="button" class="modal-close-btn" id="closeReviewModalBtn" aria-label="Close modal">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="modal-icon-wrap">
                <i class="fa-solid fa-trash-can"></i>
            </div>
            <h3 class="modal-title">Delete this review?</h3>
            <p class="modal-desc">
                Are you sure you want to remove your review? This action cannot be undone.
            </p>
            <div class="modal-actions">
                <button type="button" class="btn-modal-cancel" id="cancelReviewDeleteBtn">Cancel</button>
                <form id="deleteReviewForm" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" style="display:inline;">
                    <button type="submit" class="btn-modal-confirm">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>

</div>

<!-- Scripts -->
<script>
    // 1. Listing Delete Modal
    (function() {
        const modal = document.getElementById('deleteModalBackdrop');
        const openBtn = document.getElementById('openDeleteModalBtn');
        const closeBtn = document.getElementById('closeModalBtn');
        const cancelBtn = document.getElementById('cancelDeleteBtn');

        function openModal() {
            modal.classList.add('show-modal');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            modal.classList.remove('show-modal');
            document.body.style.overflow = '';
        }

        if (openBtn) openBtn.addEventListener('click', openModal);
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

        if (modal) {
            modal.addEventListener('click', function(e) {
                if (e.target === modal) closeModal();
            });
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && modal.classList.contains('show-modal')) {
                closeModal();
            }
        });
    })();

    // 2. Review Delete Pop-up Modal (Replaces browser alert)
    (function() {
        const reviewModal = document.getElementById('deleteReviewModalBackdrop');
        const closeReviewBtn = document.getElementById('closeReviewModalBtn');
        const cancelReviewBtn = document.getElementById('cancelReviewDeleteBtn');
        const deleteReviewForm = document.getElementById('deleteReviewForm');
        const deleteReviewBtns = document.querySelectorAll('.open-review-delete-btn');

        function openReviewModal() {
            reviewModal.classList.add('show-modal');
            document.body.style.overflow = 'hidden';
        }

        function closeReviewModal() {
            reviewModal.classList.remove('show-modal');
            document.body.style.overflow = '';
        }

        deleteReviewBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const reviewId = this.getAttribute('data-review-id');
                // Dynamically sets action route for this exact review
                deleteReviewForm.action = `/listings/<%= listing._id %>/reviews/${reviewId}?_method=DELETE`;
                openReviewModal();
            });
        });

        if (closeReviewBtn) closeReviewBtn.addEventListener('click', closeReviewModal);
        if (cancelReviewBtn) cancelReviewBtn.addEventListener('click', closeReviewModal);

        if (reviewModal) {
            reviewModal.addEventListener('click', function(e) {
                if (e.target === reviewModal) closeReviewModal();
            });
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && reviewModal.classList.contains('show-modal')) {
                closeReviewModal();
            }
        });
    })();

    // 3. Interactive Star Rating Selector
    (function() {
        const starContainer = document.getElementById('starContainer');
        const ratingInput = document.getElementById('ratingInput');
        const ratingBadge = document.getElementById('ratingBadge');

        if (!starContainer || !ratingInput) return;

        const stars = starContainer.querySelectorAll('.star-icon');
        const descriptions = {
            1: "1.0 · Poor",
            2: "2.0 · Fair",
            3: "3.0 · Average",
            4: "4.0 · Very Good",
            5: "5.0 · Excellent"
        };

        let currentRating = parseInt(ratingInput.value) || 5;

        function renderStars(rating) {
            stars.forEach(star => {
                const val = parseInt(star.getAttribute('data-value'));
                if (val <= rating) {
                    star.className = 'fa-solid fa-star star-icon';
                    star.style.color = '#FFB400';
                } else {
                    star.className = 'fa-regular fa-star star-icon';
                    star.style.color = '#d1d5db';
                }
            });
            if (ratingBadge && descriptions[rating]) {
                ratingBadge.textContent = descriptions[rating];
            }
        }

        stars.forEach(star => {
            star.addEventListener('mouseenter', () => {
                const hoverVal = parseInt(star.getAttribute('data-value'));
                renderStars(hoverVal);
            });

            star.addEventListener('click', () => {
                currentRating = parseInt(star.getAttribute('data-value'));
                ratingInput.value = currentRating;
                renderStars(currentRating);
            });
        });

        starContainer.addEventListener('mouseleave', () => {
            renderStars(currentRating);
        });

        renderStars(currentRating);
    })();

    // 4. Form Validation Script
    (() => {
        'use strict';
        const forms = document.querySelectorAll('.needs-validation');
        Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>