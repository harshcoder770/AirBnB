<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Airbnb</title>

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts: Playfair Display, Poppins, DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:wght@600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Your Custom CSS file (placed inside public/css/) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.33.0/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.33.0/mapbox-gl.js"></script>

    <!-- Global Base Layout Styles -->
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #fafafa;
            color: #1a1a2e;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Main content expands to push footer to the bottom */
        main.main-container {
            flex: 1;
            width: 100%;
        }

        .flash-toast-wrapper {
            position: fixed;
            bottom: 28px;
            /* 👈 Positioned at the bottom-right corner */
            right: 24px;
            z-index: 99999;
            max-width: 380px;
            width: calc(100% - 48px);
            animation: slideInToast 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes slideInToast {
            from {
                opacity: 0;
                transform: translateX(110%);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes slideOutToast {
            from {
                opacity: 1;
                transform: translateX(0);
            }

            to {
                opacity: 0;
                transform: translateX(110%);
            }
        }

        .flash-toast-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 12px 36px rgba(0, 0, 0, 0.15), 0 2px 8px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(0, 0, 0, 0.07);
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px 18px;
            font-family: 'DM Sans', sans-serif;
            position: relative;
        }

        .flash-toast-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .flash-toast-success .flash-toast-icon {
            background: #ecfdf5;
            color: #10b981;
        }

        .flash-toast-error .flash-toast-icon {
            background: #fef2f2;
            color: #ef4444;
        }

        .flash-toast-content {
            flex-grow: 1;
            padding-right: 8px;
        }

        .flash-toast-title {
            font-size: 14px;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 2px;
        }

        .flash-toast-msg {
            font-size: 13px;
            color: #6b7280;
            line-height: 1.4;
            margin: 0;
        }

        .flash-toast-close {
            background: none;
            border: none;
            color: #9ca3af;
            cursor: pointer;
            font-size: 14px;
            padding: 4px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s;
        }

        .flash-toast-close:hover {
            color: #1a1a2e;
        }

        @media (max-width: 480px) {
            .flash-toast-wrapper {
                bottom: 16px;
                right: 16px;
                width: calc(100% - 32px);
            }
        }
    </style>
</head>

<body>

    <!-- Navbar Include -->
    <%- include('../includes/navbar.ejs') %>

        <!-- Floating Airbnb Flash Toast Notification (Bottom-Right Corner) -->
        <% if ((typeof success !=='undefined' && success && success.length) || (typeof error !=='undefined' && error &&
            error.length)) { %>


            <div class="flash-toast-wrapper" id="flashToast">
                <% if (typeof success !=='undefined' && success && success.length) { %>
                    <div class="flash-toast-card flash-toast-success">
                        <div class="flash-toast-icon">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <div class="flash-toast-content">
                            <div class="flash-toast-title">Success</div>
                            <p class="flash-toast-msg">
                                <%= success %>
                            </p>
                        </div>
                        <button type="button" class="flash-toast-close" onclick="closeFlashToast()" aria-label="Close">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                    <% } %>

                        <% if (typeof error !=='undefined' && error && error.length) { %>
                            <div class="flash-toast-card flash-toast-error">
                                <div class="flash-toast-icon">
                                    <i class="fa-solid fa-circle-exclamation"></i>
                                </div>
                                <div class="flash-toast-content">
                                    <div class="flash-toast-title">Error</div>
                                    <p class="flash-toast-msg">
                                        <%= error %>
                                    </p>
                                </div>
                                <button type="button" class="flash-toast-close" onclick="closeFlashToast()"
                                    aria-label="Close">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                            <% } %>
            </div>

            <% } %>

                <!-- Main Dynamic Content -->
                <main class="main-container">
                    <%- body -%>
                </main>

                <!-- Footer Include -->
                <%- include('../includes/footer.ejs') %>

                    <!-- Scripts (add your custom JS if needed) -->

                    <script src="/js/validations.js"></script>
                    <!-- Bootstrap 5 JS Bundle (Includes Popper) -->
                    <script>
                        function closeFlashToast() {
                            const toast = document.getElementById('flashToast');
                            if (toast) {
                                toast.style.animation = 'slideOutToast 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards';
                                setTimeout(() => toast.remove(), 300);
                            }
                        }

                        // Auto-dismiss after 4.5 seconds
                        setTimeout(() => {
                            closeFlashToast();
                        }, 4500);
                    </script>
                    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
                        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
                        crossorigin="anonymous"></script>
</body>

</html>
