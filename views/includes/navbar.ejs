<!-- Navbar Styles -->
<style>
    .airbnb-navbar {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: #ffffff;
        border-bottom: 1px solid #ebebeb;
        padding: 0 48px;
        width: 100%;
        box-sizing: border-box;
    }

    .navbar-inner {
        height: 80px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        position: relative;
    }

    /* Logo */
    .nav-logo {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #FF385C;
        flex-shrink: 0;
    }

    .nav-logo i {
        font-size: 32px;
        transition: transform 0.2s ease;
    }

    .nav-logo:hover i {
        transform: scale(1.05);
    }

    .nav-logo span {
        font-family: 'DM Sans', sans-serif;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    /* Search Pill Form */
    .nav-search {
        display: flex;
        align-items: center;
        flex: 1;
        max-width: 440px;
        min-width: 0;
        background: #ffffff;
        border: 1px solid #dddddd;
        border-radius: 40px;
        padding: 5px 6px 5px 18px;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
        transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .nav-search:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
    }

    .nav-search:focus-within {
        border-color: #FF385C;
        box-shadow: 0 2px 10px rgba(255, 56, 92, 0.16);
    }

    .nav-search-input {
        flex: 1;
        min-width: 0;
        border: none;
        outline: none;
        background: transparent;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 500;
        color: #222222;
        padding: 6px 8px 6px 0;
    }

    .nav-search-input::placeholder {
        color: #717171;
        font-weight: 400;
    }

    .nav-search-input::-webkit-search-cancel-button {
        -webkit-appearance: none;
    }

    .search-clear-btn {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #717171;
        text-decoration: none;
        font-size: 12px;
        margin-right: 4px;
        flex-shrink: 0;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .search-clear-btn:hover {
        background: #f2f2f2;
        color: #222222;
    }

    .search-icon-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: linear-gradient(135deg, #FF385C, #D70466);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        cursor: pointer;
        flex-shrink: 0;
        transition: transform 0.15s ease, opacity 0.15s ease;
    }

    .search-icon-btn:hover {
        transform: scale(1.05);
        opacity: 0.95;
    }

    .search-icon-btn i {
        font-size: 13px;
    }

    /* User Actions */
    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
        position: relative;
    }

    .nav-host-btn {
        text-decoration: none;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        color: #222222;
        padding: 10px 14px;
        border-radius: 22px;
        transition: background 0.2s ease;
        white-space: nowrap;
    }

    .nav-host-btn:hover {
        background: #f7f7f7;
    }

    .nav-user-pill {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid #dddddd;
        border-radius: 24px;
        padding: 5px 6px 5px 12px;
        cursor: pointer;
        transition: box-shadow 0.2s ease;
        background: #ffffff;
        user-select: none;
    }

    .nav-user-pill:hover,
    .nav-user-pill.active {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.16);
    }

    .nav-user-pill i.fa-bars {
        font-size: 14px;
        color: #444444;
    }

    .user-avatar-circle {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #717171;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 700;
    }

    .user-avatar-circle.logged-in {
        background: linear-gradient(135deg, #FF385C, #D70466);
    }

    /* Dropdown Panel */
    .user-dropdown-menu {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        width: 240px;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        border: 1px solid #eeeeee;
        padding: 8px 0;
        display: none;
        flex-direction: column;
        z-index: 1100;
        animation: dropDownSlide 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .user-dropdown-menu.show {
        display: flex;
    }

    @keyframes dropDownSlide {
        from {
            opacity: 0;
            transform: translateY(-8px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .dropdown-item {
        padding: 12px 18px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        color: #222222;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: background 0.15s ease;
    }

    .dropdown-item:hover {
        background: #f7f7f7;
    }

    .dropdown-user-badge {
        padding: 10px 18px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: #1a1a2e;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .dropdown-item.bold-text {
        font-weight: 700;
    }

    .dropdown-divider {
        height: 1px;
        background: #eeeeee;
        margin: 6px 0;
    }

    /* Responsive Media Queries */
    @media (max-width: 950px) {
        .airbnb-navbar {
            padding: 0 24px;
        }

        .nav-host-btn {
            font-size: 13px;
            padding: 8px 10px;
        }
    }

    @media (max-width: 768px) {
        .airbnb-navbar {
            padding: 0 14px;
        }

        .navbar-inner {
            height: 68px;
            gap: 10px;
        }

        .nav-logo span {
            display: none;
        }

        .nav-host-btn {
            display: none;
        }

        .nav-search {
            padding: 4px 5px 4px 14px;
        }

        .nav-search-input {
            font-size: 13px;
        }

        .search-icon-btn {
            width: 32px;
            height: 32px;
        }
    }
</style>

<!-- Navbar Markup -->
<nav class="airbnb-navbar">
    <div class="navbar-inner">

        <a href="/" class="nav-logo">
            <i class="fa-brands fa-airbnb"></i>
            <span>airbnb</span>
        </a>

        <form action="/" method="GET" class="nav-search" role="search">
            <input
                type="search"
                name="q"
                class="nav-search-input"
                placeholder="Search destinations, stays, or categories..."
                value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                aria-label="Search stays"
            >
            <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                <a href="/" class="search-clear-btn" aria-label="Clear search">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            <% } %>
            <button type="submit" class="search-icon-btn" aria-label="Search">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </form>

        <div class="nav-actions">
            <a href="/listings/new" class="nav-host-btn">Airbnb your home</a>

            <div class="nav-user-pill" id="userMenuBtn">
                <i class="fa-solid fa-bars"></i>
                <div class="user-avatar-circle <%= currUser ? 'logged-in' : '' %>">
                    <% if (currUser && currUser.username) { %>
                        <%= currUser.username.charAt(0).toUpperCase() %>
                    <% } else { %>
                        <i class="fa-solid fa-user"></i>
                    <% } %>
                </div>
            </div>

            <div class="user-dropdown-menu" id="userDropdown">
                <% if (!currUser) { %>
                    <a href="/signup" class="dropdown-item bold-text">
                        <i class="fa-regular fa-user" style="width: 16px;"></i> Sign up
                    </a>
                    <a href="/login" class="dropdown-item">
                        <i class="fa-solid fa-arrow-right-to-bracket" style="width: 16px;"></i> Log in
                    </a>
                <% } else { %>
                                        <a href="/profile" class="dropdown-item bold-text">
                        <i class="fa-regular fa-user" style="width: 16px;"></i> @<%= currUser.username %>
                    </a>
                    <a href="/logout" class="dropdown-item">
                        <i class="fa-solid fa-arrow-right-from-bracket" style="width: 16px;"></i> Log out
                    </a>
                <% } %>

                <div class="dropdown-divider"></div>
                <a href="/listings/new" class="dropdown-item">
                    <i class="fa-solid fa-house-chimney" style="width: 16px;"></i> Airbnb your home
                </a>
                <a href="/" class="dropdown-item">
                    <i class="fa-solid fa-compass" style="width: 16px;"></i> Explore stays
                </a>
            </div>
        </div>

    </div>
</nav>

<!-- Dropdown Menu Toggle Script -->
<script>
    (function () {
        const menuBtn = document.getElementById('userMenuBtn');
        const dropdown = document.getElementById('userDropdown');

        if (!menuBtn || !dropdown) return;

        menuBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            dropdown.classList.toggle('show');
            menuBtn.classList.toggle('active');
        });

        document.addEventListener('click', function (e) {
            if (!dropdown.contains(e.target) && !menuBtn.contains(e.target)) {
                dropdown.classList.remove('show');
                menuBtn.classList.remove('active');
            }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                dropdown.classList.remove('show');
                menuBtn.classList.remove('active');
            }
        });
    })();
</script>