<!-- Footer Styles -->
<style>
    .airbnb-footer {
        background-color: #f7f7f7;
        border-top: 1px solid #ebebeb;
        padding: 48px 48px 28px;
        margin-top: auto;
        font-family: 'DM Sans', sans-serif;
        color: #222222;
        box-sizing: border-box;
        width: 100%;
    }

    /* ===== TOP COLUMNS ===== */
    .footer-top-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 36px;
        padding-bottom: 36px;
        border-bottom: 1px solid #dddddd;
    }

    .footer-col h4 {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 16px;
        color: #1a1a2e;
        letter-spacing: 0.3px;
    }

    .footer-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .footer-col ul li a {
        text-decoration: none;
        font-size: 14px;
        color: #555555;
        transition: color 0.2s ease, text-decoration 0.2s;
    }

    .footer-col ul li a:hover {
        color: #1a1a2e;
        text-decoration: underline;
    }

    /* ===== BOTTOM BAR ===== */
    .footer-bottom {
        padding-top: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
    }

    .footer-bottom-left {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        font-size: 14px;
        color: #717171;
    }

    .footer-bottom-left a {
        color: #717171;
        text-decoration: none;
    }

    .footer-bottom-left a:hover {
        text-decoration: underline;
        color: #222;
    }

    /* ===== AUTHOR & SOCIAL PROFILES ===== */
    .footer-creator-bar {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .creator-badge {
        font-size: 14px;
        color: #444444;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .creator-badge .heart-icon {
        color: #FF385C;
        font-size: 13px;
        animation: pulse 1.6s infinite ease-in-out;
    }

    @keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.2); }
    }

    .creator-badge strong {
        color: #1a1a2e;
        font-weight: 700;
    }

    /* Social Icons Row */
    .social-links {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .social-icon-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #ffffff;
        border: 1px solid #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555555;
        text-decoration: none;
        transition: all 0.25s ease;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        position: relative;
    }

    .social-icon-btn i {
        font-size: 16px;
    }

    .social-icon-btn svg {
        width: 17px;
        height: 17px;
        fill: currentColor;
    }

    /* Hover States for Each Brand */
    .social-icon-btn.github:hover {
        background: #24292e;
        color: #ffffff;
        border-color: #24292e;
        transform: translateY(-2px);
    }

    .social-icon-btn.linkedin:hover {
        background: #0A66C2;
        color: #ffffff;
        border-color: #0A66C2;
        transform: translateY(-2px);
    }

    .social-icon-btn.instagram:hover {
        background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
        color: #ffffff;
        border-color: transparent;
        transform: translateY(-2px);
    }

    .social-icon-btn.leetcode:hover {
        background: #FFA116;
        color: #ffffff;
        border-color: #FFA116;
        transform: translateY(-2px);
    }

    /* ===== RESPONSIVE MEDIA QUERIES ===== */
    @media (max-width: 900px) {
        .airbnb-footer {
            padding: 36px 24px 24px;
        }

        .footer-top-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 28px;
        }
    }

    @media (max-width: 650px) {
        .footer-top-grid {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .footer-bottom {
            flex-direction: column-reverse;
            align-items: flex-start;
            gap: 16px;
        }

        .footer-creator-bar {
            width: 100%;
            justify-content: space-between;
        }
    }
</style>

